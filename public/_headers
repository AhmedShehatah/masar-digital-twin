# Cache rules for Cloudflare Pages / Netlify (Vercel uses vercel.json instead)

# hashed build files never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# building photos
/images/*
  Cache-Control: public, max-age=604800

# campus data: refresh hourly, serve stale while updating
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), geolocation=(self)
